---
// トップページ ＝ アプリケーション本体。開いた瞬間に入力できる。
import Base from '../layouts/Base.astro';

const LEGEND = [
  { cls: 'error-missing-subject', label: '主語なし',       hint: '主語が見つからない文' },
  { cls: 'error-avoid-using',     label: '冗長表現',       hint: '言い換えの候補を提示' },
  { cls: 'reversed-word-order',   label: '語順エラー',     hint: '「が／は → を → から → に → する」の順を推奨' },
  { cls: 'too-many-connection',   label: '係り受け量過多', hint: '1つの文節に5つ以上が係る' },
  { cls: 'too-long-chaining',     label: '係り受け長さ冗長', hint: '係り受けが5段以上つながる' },
  { cls: 'swatch--phrase',        label: '文節長さ超過',   hint: '一覧にのみ表示' },
  { cls: 'swatch--sentence',      label: '１文長さ超過',   hint: '一覧にのみ表示' },
];
---
<Base current="app">
  <main class="wrap app">
    <section class="hero rise" data-d="0">
      <h1 class="hero__title">技術文書を、<em>係り受け</em>で読みやすく。</h1>
      <p class="hero__lead">
        文章を貼り付けて「校正する」を押すだけ。主語なし・冗長表現・語順・文節の長さ・係り受けの深さと量を、
        朱を入れるように指摘します。ページ遷移はありません。
      </p>
    </section>

    <div class="workbench">
      <!-- 入力 -->
      <form id="proof-form" class="editor rise" data-d="1" method="post" action="/njc.cgi" accept-charset="UTF-8">
        <label for="txtInput" class="editor__label">
          <span>校正したい文章</span>
          <span id="char-count" class="editor__count" aria-live="polite">0 文字</span>
        </label>
        <textarea
          id="txtInput"
          name="txtInput"
          rows="12"
          autofocus
          autocomplete="off"
          spellcheck="false"
          placeholder="ここに文章を入力してください。段落ごとに空行を入れると読みやすく表示されます。目安として数段落ずつ校正すると快適です。"
        ></textarea>
        <div class="editor__bar">
          <div class="editor__aux">
            <button type="button" id="btn-sample" class="btn btn--ghost">サンプル文を試す</button>
            <button type="button" id="btn-clear" class="btn btn--ghost">クリア</button>
          </div>
          <div class="editor__go">
            <span class="editor__kbd" aria-hidden="true"><kbd id="kbd-mod">Ctrl</kbd> + <kbd>Enter</kbd></span>
            <button type="submit" id="btn-submit" name="btnKaiseki" value="校正" class="btn btn--primary">
              <span class="spinner" aria-hidden="true"></span>
              <span class="label">校正する</span>
            </button>
          </div>
        </div>
        <p id="status" class="status" role="status" aria-live="polite"></p>
      </form>

      <!-- 凡例 -->
      <aside class="legend rise" data-d="2" aria-labelledby="legend-title">
        <h2 id="legend-title" class="legend__title">添削の凡例</h2>
        <ul class="legend__list">
          {LEGEND.map((l) => (
            <li>
              <span class={`swatch ${l.cls}`}>文字</span>
              <span class="legend__label">{l.label}</span>
              <span class="legend__hint">{l.hint}</span>
            </li>
          ))}
        </ul>
        <p class="legend__note">
          係り受け解析は自動処理のため、新語や造語では誤検出があります。主部があると分かる場合は無視して構いません。
          詳しくは <a href="/about/">使い方・備考</a> を参照してください。
        </p>
      </aside>
    </div>

    <!-- 結果 -->
    <section id="results" class="results" hidden aria-live="polite">
      <div id="summary" class="summary"></div>

      <h2 class="section-title"><span>本文</span><small>色付きの箇所が指摘です。文番号は一覧と対応します。</small></h2>
      <div id="body-text" class="paper body-text"></div>

      <div id="error-table" class="paper table-wrap">
        <h2 class="section-title"><span>校正結果</span><small>矢印以降は推奨する訂正例です。</small></h2>
        <table class="errors">
          <thead>
            <tr><th scope="col">エラー内容</th><th scope="col">文</th><th scope="col">エラー箇所</th></tr>
          </thead>
          <tbody id="error-rows"></tbody>
        </table>
      </div>
      <div id="no-errors" class="paper no-errors" hidden>
        <b>指摘はありません。</b>
        <span>係り受けが機械的に解析できる、読みやすい文章です。</span>
      </div>

      <div class="explain-wrap">
        <h2 class="section-title"><span>エラーの解説</span></h2>
        <div id="explanations" class="explanations"></div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/proofread';
</script>

<style>
  .app { padding-top: clamp(24px, 5vw, 56px); }

  /* ---- ヒーロー：短く、すぐ下が入力欄 ---- */
  .hero { max-width: 820px; margin-bottom: clamp(20px, 3vw, 32px); }
  .hero__title {
    font-size: clamp(26px, 4.2vw, 44px);
    line-height: 1.3;
    letter-spacing: .01em;
  }
  .hero__title em {
    font-style: normal;
    color: var(--shu);
    background: linear-gradient(transparent 62%, var(--shu-ink) 62%);
    padding: 0 .08em;
  }
  .hero__lead { color: var(--ink-2); margin: 12px 0 0; font-size: 15.5px; max-width: 64ch; }

  /* ---- ワークベンチ：入力 + 凡例 ---- */
  .workbench {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 22px;
    align-items: start;
  }
  @media (max-width: 880px) { .workbench { grid-template-columns: 1fr; } }

  .editor {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow-paper);
    padding: 14px 16px 12px;
    position: relative;
  }
  /* 原稿用紙の綴じ穴のような朱の縁 */
  .editor::before {
    content: ""; position: absolute; left: -1px; top: 18px; bottom: 18px; width: 3px;
    background: var(--shu); border-radius: 2px; opacity: .85;
  }
  .editor__label {
    display: flex; justify-content: space-between; align-items: baseline;
    font-family: var(--font-display); font-size: 15px; font-weight: 700; letter-spacing: .04em;
    margin: 0 2px 8px;
  }
  .editor__count { font-family: var(--font-mono); font-size: 12px; font-weight: 400; color: var(--ink-3); letter-spacing: .04em; }
  textarea {
    display: block; width: 100%; min-height: 15rem; resize: vertical;
    font: inherit; font-size: 16.5px; line-height: 1.9;
    color: var(--ink); background: var(--paper);
    border: 1px solid var(--rule); border-radius: 4px;
    padding: 14px 16px;
    transition: border-color .2s, box-shadow .2s;
  }
  textarea::placeholder { color: var(--ink-3); }
  textarea:focus { outline: none; border-color: var(--shu); box-shadow: 0 0 0 3px var(--shu-ink); }
  .editor__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; margin-top: 12px; }
  .editor__aux, .editor__go { display: flex; align-items: center; gap: 8px; }
  .editor__kbd { font-size: 12px; color: var(--ink-3); }
  @media (max-width: 520px) { .editor__kbd { display: none; } .editor__go { width: 100%; } .editor__go .btn--primary { width: 100%; } }

  .btn {
    font: inherit; font-size: 14.5px; font-weight: 500; line-height: 1;
    padding: 11px 16px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--rule-2); background: transparent; color: var(--ink-2);
    transition: .18s var(--ease-out);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn:hover { color: var(--ink); border-color: var(--ink-3); background: var(--paper); }
  .btn--primary {
    background: var(--shu); border-color: var(--shu); color: #fff;
    padding: 12px 22px; font-weight: 700; letter-spacing: .06em;
    box-shadow: 0 6px 16px -8px var(--shu);
  }
  .btn--primary:hover { background: var(--shu-deep); border-color: var(--shu-deep); color: #fff; transform: translateY(-1px); }
  .btn--primary:active { transform: translateY(0); }
  .btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
  .spinner {
    width: 14px; height: 14px; border-radius: 50%; display: none;
    border: 2px solid rgba(255,255,255,.35); border-top-color: #fff;
    animation: spin .8s linear infinite;
  }
  .is-busy .spinner { display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .status { margin: 10px 2px 0; min-height: 1.6em; font-size: 13.5px; color: var(--ink-2); }
  .status[data-kind="error"] { color: var(--shu); }
  .status[data-kind="busy"]::before { content: "▮"; display: inline-block; margin-right: .4em; animation: blink 1s steps(2) infinite; color: var(--shu); }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---- 凡例 ---- */
  .legend { padding: 4px 2px; }
  .legend__title { font-size: 15px; letter-spacing: .08em; color: var(--ink-2); margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid var(--rule); }
  .legend__list { list-style: none; margin: 0; padding: 0; }
  .legend__list li {
    display: grid; grid-template-columns: 3.2em 1fr; column-gap: 12px; align-items: baseline;
    padding: 7px 0; border-bottom: 1px dashed var(--rule);
    font-size: 14px;
  }
  .legend__list li .swatch { justify-self: start; }
  .legend__label { font-weight: 700; }
  .legend__hint { grid-column: 2; font-size: 12.5px; color: var(--ink-3); line-height: 1.5; }
  .legend__note { font-size: 12.5px; color: var(--ink-3); margin: 12px 0 0; line-height: 1.7; }
</style>

<!-- 結果セクションは JS が動的に生成するため、Astro の scoped style（data-astro-cid）が
     付かない。ここだけ is:global にして .results 配下に限定する。 -->
<style is:global>
  .results { margin-top: clamp(28px, 4vw, 48px); scroll-margin-top: 90px; }
  .results[aria-busy="true"] { opacity: .5; }
  .results .summary { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .results .chip {
    display: inline-flex; align-items: center; gap: 8px;
    font: inherit; font-size: 13.5px; padding: 6px 12px 6px 10px; border-radius: 999px;
    border: 1px solid var(--rule-2); background: var(--paper-2); color: var(--ink); cursor: pointer;
    transition: .15s;
  }
  .results .chip:hover { border-color: var(--ink-3); }
  .results .chip i { width: 10px; height: 10px; border-radius: 3px; background: var(--chip-accent); }
  .results .chip b { font-family: var(--font-mono); font-weight: 500; color: var(--ink-2); }
  .results .chip--total { cursor: default; background: var(--ink); color: var(--paper); border-color: var(--ink); gap: 6px; }
  .results .chip--total b { color: var(--paper); font-size: 16px; }

  .results .section-title {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px;
    font-size: 19px; margin: 26px 0 10px; letter-spacing: .06em;
  }
  .results .section-title::before { content: ""; width: 4px; height: .9em; background: var(--shu); border-radius: 1px; align-self: center; }
  .results .section-title small { font-family: var(--font-body); font-weight: 400; font-size: 12.5px; color: var(--ink-3); letter-spacing: 0; }
  .results .table-wrap .section-title, .results .explain-wrap .section-title { margin-top: 0; }

  .results .paper {
    background: var(--paper-2); border: 1px solid var(--rule); border-radius: var(--radius);
    box-shadow: var(--shadow-paper); padding: 18px 20px;
  }
  .results .body-text { font-size: 16.5px; line-height: 2.1; }
  .results .sentence { display: grid; grid-template-columns: 2.4em 1fr; gap: 10px; margin: 0; padding: 4px 0; }
  .results .sentence + .sentence { border-top: 1px dashed var(--rule); }
  .results .sentence__no {
    font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); line-height: 2.1;
    text-align: right; padding-right: 8px; border-right: 1px solid var(--rule);
  }
  .results .sentence[data-errors] .sentence__no { color: var(--shu); font-weight: 500; }
  .results .sentence__text { overflow-wrap: anywhere; }
  .results .is-flash { animation: flash 1.2s var(--ease-out); }
  @keyframes flash { 0% { background: var(--shu-ink); } 100% { background: transparent; } }

  .results .table-wrap { margin-top: 22px; overflow-x: auto; }
  .results table.errors { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .results table.errors th {
    text-align: left; font-family: var(--font-display); font-weight: 700; font-size: 13px; letter-spacing: .06em;
    color: var(--ink-2); padding: 6px 10px; border-bottom: 2px solid var(--rule-2); white-space: nowrap;
  }
  .results table.errors td { padding: 9px 10px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .results table.errors tr:last-child td { border-bottom: 0; }
  .results table.errors tr.is-flash td { background: var(--shu-ink); }
  .results .col-type { white-space: nowrap; font-weight: 700; }
  .results .col-type i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: var(--row-accent); margin-right: 8px; vertical-align: -1px; }
  .results .col-no { font-family: var(--font-mono); text-align: center; width: 3em; }
  .results .col-no a { text-decoration: none; padding: 1px 6px; border-radius: 4px; border: 1px solid var(--rule-2); color: var(--ink-2); }
  .results .col-no a:hover { color: var(--shu); border-color: var(--shu); }
  .results .col-msg { line-height: 1.75; overflow-wrap: anywhere; }
  /* 狭い画面では一覧をカード状に */
  @media (max-width: 640px) {
    .results table.errors thead { display: none; }
    .results table.errors, .results table.errors tbody, .results table.errors tr, .results table.errors td { display: block; }
    .results table.errors tr { padding: 10px 0; border-bottom: 1px solid var(--rule); }
    .results table.errors tr:last-child { border-bottom: 0; }
    .results table.errors td { padding: 0; border: 0; }
    .results .col-type { display: inline-block; margin-right: 10px; }
    .results .col-no { display: inline-block; width: auto; }
    .results .col-no::before { content: "文 "; font-family: var(--font-body); font-size: 12px; color: var(--ink-3); }
    .results .col-msg { margin-top: 4px; padding-left: 18px; }
  }

  .results .no-errors { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: baseline; border-left: 4px solid var(--ok); }
  .results .no-errors b { font-family: var(--font-display); font-size: 17px; }
  .results .no-errors span { color: var(--ink-2); font-size: 14px; }

  .results .explain-wrap { margin-top: 26px; }
  .results .explanations { display: grid; gap: 8px; }
  .results .explain {
    background: var(--paper-2); border: 1px solid var(--rule); border-radius: var(--radius); padding: 0 16px;
  }
  .results .explain summary {
    cursor: pointer; padding: 12px 0; font-family: var(--font-display); font-weight: 700; letter-spacing: .04em;
    display: flex; align-items: center; gap: 10px; list-style: none;
  }
  .results .explain summary::-webkit-details-marker { display: none; }
  .results .explain summary::after { content: "＋"; margin-left: auto; color: var(--ink-3); font-family: var(--font-body); }
  .results .explain[open] summary::after { content: "−"; }
  .results .explain summary i { width: 10px; height: 10px; border-radius: 3px; background: var(--row-accent); }
  .results .explain p { margin: 0 0 14px; color: var(--ink-2); font-size: 14.5px; line-height: 1.85; }
</style>
